# Local dev (docker-compose Postgres). For Neon, use the -pooler URL for the app
# and the direct (non-pooled) URL for migrations.
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio
DATABASE_URL_DIRECT=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-byte-random-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=604800

# Bootstrap admin user. Only used by scripts/bootstrap_admin.py on first run.
ADMIN_BOOTSTRAP_USERNAME=anirudh
ADMIN_BOOTSTRAP_PASSWORD=

# Comma-separated origins. Never use * with credentials.
CORS_ORIGINS=http://localhost:5173

ENV=development
