# =============================================================================
# Top-level reference — see backend/.env.example and frontend/.env.example
# for the actual files each app reads.
# =============================================================================

# ---- Database (Postgres) ----
# For local docker-compose:   postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio
# For Neon: use the *-pooler* host for DATABASE_URL (app), and the direct host
# for DATABASE_URL_DIRECT (Alembic migrations + scripts).
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio
DATABASE_URL_DIRECT=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio

# ---- JWT ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=604800

# ---- First-run admin bootstrap ----
ADMIN_BOOTSTRAP_USERNAME=anirudh
ADMIN_BOOTSTRAP_PASSWORD=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Env ----
ENV=development

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
